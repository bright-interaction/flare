# Flare environment. Copy to .env and fill real values (never commit .env).
ENVIRONMENT=production
BASE_URL=https://flare.example.com

# Secrets. CSRF_KEY must be exactly 32 bytes; SESSION_KEY 32+ bytes.
# Generate: openssl rand -base64 24
SESSION_KEY=your_session_key_here_change_me
CSRF_KEY=your_csrf_key_32_bytes_change_me!
# FLARE_SECRET_KEY encrypts integration secrets at rest (BYOAI keys, OIDC client
# secrets, notification-channel configs). With ENVIRONMENT=production above,
# Flare REFUSES TO BOOT without it. Generate: openssl rand -base64 32
# Treat as permanent: rotating it makes existing encrypted values unreadable.
FLARE_SECRET_KEY=your_secret_key_here_change_me

# Postgres. docker-compose composes DATABASE_URL from this password; override
# DATABASE_URL directly to point at an external Postgres instead.
FLARE_DB_PASSWORD=changeme_postgres
# DATABASE_URL=postgres://flare:changeme_postgres@flare-db:5432/flare?sslmode=disable

# Optional. Redis for ingest rate-limit / dedupe counters (graceful if unset).
REDIS_URL=

# Transactional email (alert delivery + password reset). Optional: leave
# SMTP_HOST/SMTP_FROM empty to run without email (those features no-op).
# Works with any SMTP server (self-host, mailhog in dev, Resend/SES in prod).
# SMTP_TLS: "tls" (implicit, port 465) | "starttls" (587) | "none" (dev only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Flare
SMTP_TLS=starttls

# Telemetry retention (days). Aged partitions are exported to Parquet then dropped.
RETENTION_DAYS=30

# Cold-tier Parquet. Local dir by default (self-host with a mounted volume).
# To archive to S3/MinIO instead, set the S3 vars below.
FLARE_PARQUET_DIR=/app/data/parquet
# FLARE_PARQUET_S3_ENDPOINT=s3.example.com
# FLARE_PARQUET_S3_BUCKET=flare
# FLARE_PARQUET_S3_ACCESS_KEY=changeme
# FLARE_PARQUET_S3_SECRET_KEY=changeme
# FLARE_PARQUET_S3_REGION=us-east-1
# FLARE_PARQUET_S3_USE_SSL=true
