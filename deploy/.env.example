# Flare self-host configuration. Copy to .env and fill in.
#   cp .env.example .env

# Public URL Flare is reached at (used in project DSNs and email links).
FLARE_BASE_URL=http://localhost:8080
# Host port to publish Flare on.
FLARE_PORT=8080

# --- Secrets (REQUIRED) --------------------------------------------------
# SESSION_KEY: 32+ bytes.   generate: openssl rand -base64 32
# CSRF_KEY:    EXACTLY 32 bytes.  generate: openssl rand -hex 16
# FLARE_SECRET_KEY: encrypts integration secrets at rest (BYOAI keys, OIDC
#   client secrets, notification-channel configs). Production REFUSES TO BOOT
#   without it. generate: openssl rand -base64 32
#   Treat as permanent: rotating it makes existing encrypted values unreadable.
# FLARE_DB_PASSWORD: the Postgres password (any strong string).
SESSION_KEY=
CSRF_KEY=
FLARE_SECRET_KEY=
# Left EMPTY on purpose. docker-compose.yml uses
#   ${FLARE_DB_PASSWORD:?set FLARE_DB_PASSWORD in .env}
# so an unset value stops the stack with that message. Shipping a working
# default here defeats that: copying .env.example verbatim would bring up a
# database whose password is published in this repo, and nothing would complain
# because it works. Generate one: openssl rand -hex 16
FLARE_DB_PASSWORD=

# --- Telemetry retention -------------------------------------------------
# Days kept in Postgres before aged partitions export to Parquet and drop.
FLARE_RETENTION_DAYS=30

# Retention only drops a partition once it is archived to the cold tier. If the
# cold tier is unreachable (DuckDB failed to load its extensions, no outbound
# internet on first boot), retention PAUSES and partitions accumulate rather
# than telemetry being destroyed unarchived. You will see a loud error every
# cycle. Set this to true only if you deliberately run with no cold tier and
# accept that aged telemetry is deleted, not archived.
# FLARE_ALLOW_DROP_WITHOUT_EXPORT=true

# --- Email (OPTIONAL) ----------------------------------------------------
# Enables alert emails + password reset. Works with any SMTP server.
# Leave SMTP_HOST/SMTP_FROM blank to run without email.
# SMTP_TLS: tls (implicit, port 465) | starttls (587) | none (dev only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Flare
SMTP_TLS=starttls

# --- Cold tier to S3/MinIO (OPTIONAL) ------------------------------------
# By default Parquet is written to a local volume. To archive to object
# storage instead, set these (see README).
# FLARE_PARQUET_S3_ENDPOINT=
# FLARE_PARQUET_S3_BUCKET=flare
# FLARE_PARQUET_S3_ACCESS_KEY=
# FLARE_PARQUET_S3_SECRET_KEY=
